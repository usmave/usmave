<Window x:Class="NeuralSwap.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeuralSwap – DLSS 5 One-Click-Mods"
        Width="1100" Height="720" MinWidth="860" MinHeight="560"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="ScanButton" Click="ScanButton_Click">🔍 Spiele scannen</Button>
                <Button x:Name="OneClickButton" Style="{StaticResource AccentButton}" Click="OneClickButton_Click">⚡ One-Click: Alle Spiele aktualisieren</Button>
                <Button x:Name="LibraryButton" Click="LibraryButton_Click">📚 DLL-Bibliothek…</Button>
                <Button x:Name="AddFolderButton" Click="AddFolderButton_Click">➕ Spielordner hinzufügen…</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <CheckBox x:Name="ForcePresetCheck" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Wirkt nur in Spielen mit OptiScaler; sonst das Preset in der NVIDIA App setzen.">Upscaling-Preset erzwingen:</CheckBox>
                <ComboBox x:Name="PresetCombo" VerticalAlignment="Center" Width="220"/>
            </StackPanel>
        </DockPanel>

        <!-- Hauptbereich -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Spieleliste -->
            <DockPanel Grid.Column="0">
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,6"
                         Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
                         BorderBrush="#FF3A4150" TextChanged="SearchBox_TextChanged"
                         ToolTip="Spiele filtern"/>
                <ListBox x:Name="GamesList" SelectionChanged="GamesList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Detailbereich -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16">
                <Grid>
                    <TextBlock x:Name="NoSelectionText" Foreground="{StaticResource TextDimBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center">
                        Links ein Spiel auswählen –&#x0a;oder oben „Spiele scannen" starten.
                    </TextBlock>
                    <DockPanel x:Name="DetailPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="GameTitle" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="GamePath" Foreground="{StaticResource TextDimBrush}" FontSize="11"
                                       Margin="0,2,0,2" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="GameWarning" Foreground="{StaticResource WarnBrush}" FontSize="12"
                                       Margin="0,0,0,8" Visibility="Collapsed"
                                       Text="⚠ Xbox/Game-Pass-Titel: Geschützte Dateien werden per Besitzübernahme entsperrt – das klappt nicht bei jedem Spiel, und App-Updates des Spiels setzen die Mods zurück."/>
                            <TextBlock x:Name="NrStatusText" Foreground="{StaticResource TextDimBrush}" FontSize="12"
                                       Margin="0,0,0,4" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <TextBlock Text="Neural Rendering – fotorealistische Gesichter &amp; Beleuchtung (über DLSS5oneclick)"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
                            <WrapPanel Margin="0,0,0,10">
                                <Button x:Name="NeuralInstallButton" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="NeuralInstallButton_Click">🧠 Installieren / Aktualisieren</Button>
                                <Button x:Name="NeuralDiagnoseButton" Margin="0,0,8,6" Click="NeuralDiagnoseButton_Click">🩺 Diagnose</Button>
                                <Button x:Name="NeuralNextButton" Margin="0,0,8,6" Click="NeuralNextButton_Click">⏭ Klappt nicht? Nächstes Setup</Button>
                                <Button x:Name="NeuralHooksButton" Margin="0,0,8,6" Click="NeuralHooksButton_Click">🔧 EnableHooks…</Button>
                                <Button x:Name="NeuralRemoveButton" Margin="0,0,8,6" Click="NeuralRemoveButton_Click">🗑 Entfernen</Button>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,4">
                                <TextBlock Text="Stärke:" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <ComboBox x:Name="QualityCombo" Width="180" VerticalAlignment="Center" Margin="0,0,16,6"/>
                                <CheckBox x:Name="SharpenCheck" VerticalAlignment="Center" Margin="0,0,6,6">Schärfe:</CheckBox>
                                <Slider x:Name="SharpnessSlider" Width="130" Minimum="0" Maximum="1" Value="0.3"
                                        TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,0,6"
                                        ValueChanged="SharpnessSlider_ValueChanged"/>
                                <TextBlock x:Name="SharpnessLabel" Text="30 %" VerticalAlignment="Center" Margin="6,0,16,6" Width="44"/>
                                <Button x:Name="ApplyTweaksButton" Margin="0,0,8,6" Click="ApplyTweaksButton_Click">🖼 Bild-Einstellungen anwenden</Button>
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="UpdateGameButton" Style="{StaticResource AccentButton}" Margin="0,0,8,6" Click="UpdateGameButton_Click">⚡ DLLs dieses Spiels aktualisieren</Button>
                                <Button x:Name="RestoreButton" Margin="0,0,8,6" Click="RestoreButton_Click">↩ Original-DLLs wiederherstellen</Button>
                                <Button x:Name="PresetButton" Margin="0,0,8,6" Click="PresetButton_Click">🎛 Nur Preset setzen</Button>
                                <Button x:Name="OptiScalerButton" Margin="0,0,8,6" Click="OptiScalerButton_Click">🧩 OptiScaler installieren</Button>
                            </WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="DllList" Margin="0,8,0,0" Background="{StaticResource PanelLightBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding KindName}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Version}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource TextDimBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Protokoll -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Protokoll" Foreground="{StaticResource TextDimBrush}" Margin="0,0,0,4"/>
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#FF0E1015" Foreground="#FFB9C2D0"
                     BorderBrush="#FF3A4150" FontFamily="Consolas" FontSize="12"/>
        </DockPanel>
    </Grid>
</Window>
