<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NeuralSwap</AssemblyName>
    <RootNamespace>NeuralSwap.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <!-- Erlaubt das Kompilieren des Windows-Targets auch auf Linux-CI. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../NeuralSwap.Core/NeuralSwap.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../../manifest/dll-manifest.json" Link="dll-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
